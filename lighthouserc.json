{
  "ci": {
    "collect": {
      "staticDistDir": null,
      "url": [
        "http://localhost:3000/auth/sign-up",
        "http://localhost:3000/auth/sign-in",
        "http://localhost:3000/auth/forgot-password"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "pnpm --filter @wafar/web preview --host 127.0.0.1 --port 3000",
      "startServerReadyPattern": "127\\.0\\.0\\.1:3000|localhost:3000",
      "settings": {
        // The plan fixes the mobile preset with simulated throttling (T024, T197).
        "preset": "mobile",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "interactive": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
