#!/bin/sh
# Wafar governance drift check - see docs/DECISIONS.md. The ADRs that built and
# extended this check are named in the check's own header line
# (governance-drift-check.mjs, first comment block), which is the single
# authority for that list; this hook deliberately carries no copy of it.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# It runs the committed, dependency-free drift check and blocks the commit when
# governance has drifted. Bypass deliberately with `git commit --no-verify`;
# the real enforcement point is the CI provider R1 wires this into.
node governance-drift-check.mjs || exit 1
