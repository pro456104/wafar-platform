# Machine-local Spec Kit state — not meant to be shared.
# Managed by the Specify CLI; safe to edit (your changes are preserved on refresh).

# Local pointer to the current feature directory. Rewritten every time you
# switch features, so it is per-checkout state rather than something to share.
feature.json

# Per-machine extension config overrides.
extensions/*/local-config.yml

# Refreshed catalog metadata the CLI rewrites on every check. Machine state,
# not project content: tracked, it dirties the working tree on any command and
# arrives with the CRLF endings .gitattributes reserves away from *.json
# (ADR-039). A fresh clone regenerates it. See ADR-063.
extensions/.cache/

# Refreshed integration-catalog metadata. Same reasoning as extensions/.cache/
# above: machine state the CLI rewrites on every check, tracked it dirties the
# working tree on any command. A fresh clone regenerates it. See ADR-068.
integrations/.cache/
